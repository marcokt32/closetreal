# Copie este arquivo para ".env" e preencha. NUNCA envie o .env para o GitHub.

# --- Mercado Pago (Painel de desenvolvedor > Suas integrações > Credenciais) ---
MP_ACCESS_TOKEN=

# Assinatura secreta do webhook (Painel do Mercado Pago > Suas integrações > Webhooks).
# URL a cadastrar lá: <BASE_URL>/webhook   |   evento: "Pagamentos".
# Em produção, preencha: sem ela a loja aceita notificações sem conferir quem enviou.
MP_WEBHOOK_SECRET=
# De quantos em quantos minutos a loja confere no Mercado Pago os pedidos que ainda aguardam pagamento
# (cobre notificação perdida). Padrão 10; 0 desliga.
# MP_CONFERE_MINUTOS=10

# --- Melhor Envio ---
# Sandbox: https://sandbox.melhorenvio.com.br   | Produção: https://melhorenvio.com.br
MELHOR_ENVIO_URL=https://sandbox.melhorenvio.com.br
MELHOR_ENVIO_TOKEN=
# O Melhor Envio exige identificar a aplicação: "Nome da loja (email de contato)"
ME_USER_AGENT=Closet Real (seu-email@dominio.com.br)
# CEP de onde as encomendas saem (somente números)
CEP_ORIGEM=25500000

# --- Endereço público do site (sem barra no final) ---
# Teste com ngrok: https://xxxx.ngrok-free.dev   | Produção: https://www.sualoja.com.br
BASE_URL=

# --- Admin ---
# Senha do painel (mínimo 10 caracteres; use uma forte, com letras, números e símbolos)
# ATENÇÃO: coloque entre aspas, senão símbolos como # cortam a senha. Ex.: ADMIN_PASSWORD="Minha#Senha$2026"
ADMIN_PASSWORD=
# Texto aleatório longo (mínimo 32 caracteres) usado para assinar a sessão.
# Gere um com:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# --- Opcionais ---
PORT=3000
# Caminho do banco SQLite (em produção, aponte para um disco persistente)
DB_PATH=loja.db
# Pasta das fotos enviadas pelo painel (em produção, aponte para um disco persistente)
# UPLOADS_DIR=public/uploads
# Em produção (com HTTPS), use "production" para o cookie de sessão ser "secure"
NODE_ENV=development

# --- Publicação (veja PUBLICAR.md e deploy/env.producao.example) ---
# Pasta das cópias de segurança diárias (padrão: pasta "backups" ao lado do banco)
# BACKUP_DIR=
# Quantas cópias diárias do banco guardar (0 desliga) e a partir de que hora (0-23) fazer
# BACKUP_DIAS=14
# BACKUP_HORA=3
# Quantos proxies existem na frente do app (nginx sozinho = 1)
# TRUST_PROXY=1

# --- Dados da loja (REMETENTE das etiquetas do Melhor Envio) ---
# Precisam ser os mesmos cadastrados na sua conta do Melhor Envio.
LOJA_NOME=Closet Real
LOJA_EMAIL=
LOJA_TELEFONE=
# CPF (11 números) ou CNPJ (14 números), só dígitos
LOJA_DOCUMENTO=
# Só se tiver CNPJ com inscrição estadual (pode deixar vazio)
LOJA_INSCRICAO_ESTADUAL=
LOJA_ENDERECO=
LOJA_NUMERO=
LOJA_COMPLEMENTO=
LOJA_BAIRRO=
LOJA_CIDADE=
LOJA_UF=RJ

# --- Etiquetas (opcionais) ---
# Atualização automática do rastreio, em minutos (0 desliga)
ME_SYNC_MINUTOS=60
# Só para Jadlog com nota fiscal e token gerado no painel (consulte o Melhor Envio)
# ME_AGENCIA_ID=

# --- Contato público da loja (rodapé, página Contato e políticas) — tudo opcional ---
# Já usados no rodapé: LOJA_NOME, LOJA_EMAIL, LOJA_TELEFONE, LOJA_DOCUMENTO e o endereço da loja.
# WhatsApp (DDD + número). Se preenchido, a página Contato mostra um botão de conversa.
LOJA_WHATSAPP=
# Instagram (sem o @)
LOJA_INSTAGRAM=
# Horário de atendimento, como quer que apareça. Ex.: Segunda a sexta, das 9h às 17h
LOJA_HORARIO=
# Endereço mostrado ao público. Em branco = endereço completo da loja acima.
# Se o endereço for sua casa, pode usar só cidade/UF. Ex.: Belford Roxo/RJ
LOJA_ENDERECO_PUBLICO=
# CPF/CNPJ no rodapé: a lei de e-commerce pede a identificação do vendedor. Use "nao" para esconder.
# LOJA_EXIBIR_DOCUMENTO=sim
