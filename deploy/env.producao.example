# ============================================================
# .env DE PRODUÇÃO (no servidor). NUNCA envie este arquivo para o GitHub.
# Em Railway/Render, cadastre estas mesmas variáveis no painel da hospedagem.
# ============================================================

NODE_ENV=production
# Em Railway/Render a porta é definida pela hospedagem: não coloque PORT lá.
PORT=3000

# Endereço público da loja (SEM barra no final). Precisa ser https.
BASE_URL=https://SEU_DOMINIO.com.br

# --- Onde ficam os dados: use uma pasta em DISCO PERSISTENTE ---
# VPS:               /var/lib/closetreal      Railway/Render: o caminho do volume/disco (ex.: /data)
DB_PATH=/var/lib/closetreal/loja.db
UPLOADS_DIR=/var/lib/closetreal/uploads
BACKUP_DIR=/var/lib/closetreal/backups
# Quantas cópias diárias do banco guardar (0 desliga) e a partir de que hora (0-23) fazer
BACKUP_DIAS=14
BACKUP_HORA=3

# Quantos proxies existem na frente do app (nginx sozinho = 1). Veja Sistema > "IP que o servidor enxerga".
TRUST_PROXY=1

# --- Painel administrativo ---
ADMIN_PASSWORD=
# Gere com:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# --- Mercado Pago: credenciais de PRODUÇÃO ---
MP_ACCESS_TOKEN=
# Assinatura secreta do webhook no MODO PRODUTIVO (é diferente da do modo de teste)
MP_WEBHOOK_SECRET=
MP_CONFERE_MINUTOS=10

# --- Melhor Envio: PRODUÇÃO (conta e token próprios; o sandbox é outro cadastro) ---
MELHOR_ENVIO_URL=https://melhorenvio.com.br
MELHOR_ENVIO_TOKEN=
ME_USER_AGENT=Closet Real (seu-email@dominio.com.br)
CEP_ORIGEM=

# --- Dados da loja (iguais aos cadastrados na conta do Melhor Envio) ---
LOJA_NOME=Closet Real
LOJA_EMAIL=
LOJA_TELEFONE=
LOJA_DOCUMENTO=
LOJA_ENDERECO=
LOJA_NUMERO=
LOJA_COMPLEMENTO=
LOJA_BAIRRO=
LOJA_CIDADE=
LOJA_UF=

# --- Contato público (opcionais) ---
LOJA_WHATSAPP=
LOJA_INSTAGRAM=
LOJA_HORARIO=
LOJA_ENDERECO_PUBLICO=
